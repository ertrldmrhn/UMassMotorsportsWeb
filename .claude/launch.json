{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "umass-motorsports",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "website-live-demo",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--port",
        "8787",
        "--var",
        "LIVE_TOKEN:local-demo-only"
      ],
      "port": 8787
    }
  ]
}